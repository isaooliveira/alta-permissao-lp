# Supabase — copie do painel: Settings > API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Supabase Service Role — usado APENAS na API Route do webhook (nunca no frontend)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Hotmart Webhook — copie de: Ferramentas > Webhooks > Hottok
HOTMART_WEBHOOK_SECRET=seu-hottok-aqui

# Painel do funil (/eap/funil) — cole o JSON da conta de serviço na Vercel
GA_PROPERTY_ID=414824091
GA_SERVICE_ACCOUNT_JSON={"type":"service_account"}
FUNIL_SECRET=uma-senha-sua

# Página de obrigado — convite do grupo de WhatsApp das alunas
VITE_WHATSAPP_GRUPO_URL=https://chat.whatsapp.com/EZWobbSUyGX9sLbRvgaJkL
